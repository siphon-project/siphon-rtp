# syntax=docker/dockerfile:1
#
# Compile-check the XDP datapath: the eBPF classifier (siphon-rtp-ebpf) + the userspace loader
# (siphon-rtp-xdp). Kept separate from the main Dockerfile so the kernel-acceleration toolchain
# (nightly + bpf-linker + LLVM) never bloats the engine image.
#
#   docker build -f deploy/Dockerfile.xdp -t siphon-rtp-xdp-check .
#
# Building the loader runs its build.rs → aya-build, which compiles the eBPF program with the eBPF
# crate's own pinned nightly (rust-src / build-std) and bpf-linker, then embeds it; the loader
# itself builds on stable + aya. A green build proves the whole XDP path compiles.

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential pkg-config clang llvm \
        libzstd1 libxml2 libffi8 libtinfo6 libedit2 zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Rust: stable (loader) + the PINNED nightly with rust-src (eBPF build-std for bpfel-unknown-none).
# Pinned to nightly-2026-01-15 (LLVM 21.1.8) so it matches bpf-linker's rust-llvm-21 below — the
# latest nightly's LLVM 22 dlopen-fails with the published bpf-linker. Keep in lockstep with
# crates/siphon-rtp-xdp/ebpf/rust-toolchain.toml and build.rs.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup toolchain install nightly-2026-01-15 --component rust-src

# bpf-linker performs the final BPF link. Built for rust-llvm-21 (loads the pinned nightly's LLVM 21
# at link time) — no system LLVM needed.
RUN cargo install bpf-linker --locked --no-default-features --features rust-llvm-21

WORKDIR /build
COPY . .
