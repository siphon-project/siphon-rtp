# Rust build artifacts
/target
# The XDP loader is its own (excluded) workspace, so its target/ is not under /target.
/crates/siphon-rtp-xdp/target
**/*.rs.bk

# cargo-fuzz: build output, generated corpora, and crash artifacts (the targets are tracked).
/fuzz/target
/fuzz/corpus
/fuzz/artifacts
/fuzz/coverage

# Local tooling / editor scratch — never commit.
CLAUDE.md
.claude/
*.plan
plans/
# Scratch git worktrees. `.claude/worktrees/` is already covered by `.claude/` above, but a
# worktree checked out at the repo root is not, and a stray `git add -A` would commit a whole
# second copy of the tree.
/.worktrees/
/worktrees/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Python bytecode (the examples/ scripts)
__pycache__/
*.pyc

# Bench / profiling output
/criterion
perf.data*
flamegraph*.svg
